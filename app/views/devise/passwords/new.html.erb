<% content_for :title, "Forgot password - AgriSurya" %>

<section class="auth-card">
  <h2 class="section-title">Forgot your password?</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "contact-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-group">
      <%= f.label :email %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
    </div>

    <%= f.submit "Send reset instructions", class: "btn btn-block" %>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
