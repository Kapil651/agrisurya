<% content_for :title, "AgriSurya - Modern Agri-Business Solutions" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "public", "data-turbo-track": "reload" %>
<% end %>

<header>
  <div class="nav-container">
    <div class="logo">
      <%= image_tag 'logo_black.png', type: 'image/png', style: 'height: 70px' %>
      <div>Agri<span>Surya</span></div>
    </div>

    <ul class="nav-menu">
      <% @nav_links.each do |label, anchor| %>
        <li><%= link_to label, anchor %></li>
      <% end %>
    </ul>
  </div>
</header>

<div class="hero" id="home">
  <div class="hero-content">
    <h1>Sustainable Agriculture for a Better Tomorrow</h1>
    <p>Providing cutting-edge supply chain, eco-friendly farming practices, and marketplace solutions for modern agribusiness.</p>
    <%= link_to "Partner With Us", "#contact", class: "btn" %>
  </div>
</div>

<section id="services">
  <h2 class="section-title">Our Services</h2>
  <div class="grid">
    <% @services.each do |service| %>
      <div class="card">
        <h3><%= service[:icon] %> <%= service[:title] %></h3>
        <p><%= service[:description] %></p>
      </div>
    <% end %>
  </div>
</section>

<section id="about" class="about">
  <div class="about-inner">
    <h2 class="section-title">About Our Farm</h2>
    <div class="about-container">
      <div class="about-text">
        <h3 class="text-center">Empowering Farmers Since 2012</h3>
        <p>We act as a direct liaison between family farms and industrial distribution nodes. By engineering clean, zero-waste storage operations, our network ensures premium pricing protection for standard regional producers.</p>
        <p>Our core strategy uses automated precision watering alongside localized compost networks to offset environmental resource footprints entirely.</p>
      </div>
    </div>
  </div>
</section>

<section id="contact">
  <h2 class="section-title">Get In Touch</h2>
  <%= form_with url: root_path, method: :get, data: { turbo: false }, html: { class: "contact-form", onsubmit: "event.preventDefault(); alert('Message sent successfully!');" } do |form| %>
    <div class="form-group">
      <%= form.label :name, "Full Name" %>
      <%= form.text_field :name, required: true, placeholder: "John Doe" %>
    </div>
    <div class="form-group">
      <%= form.label :email, "Business Email" %>
      <%= form.email_field :email, required: true, placeholder: "john@company.com" %>
    </div>
    <div class="form-group">
      <%= form.label :phone, "Business Phone" %>
      <%= form.telephone_field :phone, required: true, placeholder: "1234567890" %>
    </div>
    <div class="form-group">
      <%= form.label :message, "How can we help you?" %>
      <%= form.text_area :message, rows: 5, required: true, placeholder: "Tell us about your land, crops, or distribution goals..." %>
    </div>
    <%= form.submit "Submit Inquiry", class: "btn btn-block" %>
  <% end %>
</section>

<footer>
  <p>&copy; <%= Time.current.year %> AgriSurya Bharat Pvt LTD. Built responsively without external dependencies.</p>
</footer>
